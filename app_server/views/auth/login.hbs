{{!-- 
  === View: auth/login.hbs ===
  Purpose:
    - Login landing screen.
    - Left: Welcome and description.
    - Right: Username/password login form (placeholder behavior).
    - Below: Temporary login method using users from users.json.
--}}

<section class="login-page">

  <div class="login-grid">
    {{!-- Left/center column: Intro text --}}
    <div class="login-intro">
      <h1>Welcome to the Inventory Management System for CS-499</h1>
      <p>
        This application is a prototype inventory management system designed to help track
        items, materials, and hardware owned by the department. It demonstrates full-stack
        design concepts, role-based access, and secure data handling as part of the CS-499
        Computer Science Capstone.
      </p>
    </div>

    {{!-- Right column: Primary login form --}}
    <div class="login-form">
      <h2>Sign In</h2>

      {{#if error}}
        <div class="error-box">
          <p>{{error}}</p>
        </div>
      {{/if}}

      {{#if success}}
        <div class="success-box">
          <p>{{success}}</p>
        </div>
      {{/if}}

    <form id="primaryLoginForm" method="POST" action="/">
      <div class="form-group">
        <label for="usernameInput">Username</label>
        <input
          type="text"
          id="usernameInput"
          name="username"
          placeholder="Username"
          autocomplete="off"
        >
      </div>

      <div class="form-group">
        <label for="passwordInput">Password</label>
        <input
          type="password"
          id="passwordInput"
          name="password"
          placeholder="Password"
        >
      </div>

      <button id="primaryLoginBtn" class="btn" type="submit">
        Log In
      </button>
    </form>

      <div class="login-links">
        <button type="button" class="link-button" id="forgotUsernameBtn">
          Forgot username
        </button>
        <button type="button" class="link-button" id="forgotPasswordBtn">
          Forgot password
        </button>
      </div>

      <div class="login-links">
        <button type="button" class="link-button" id="createAccountBtn">
          Create account
        </button>
      </div>
    </div>
  </div>

  <div id="createAccountModal" class="auth-modal-backdrop hidden">
  <div class="auth-modal">
    <h2>Create Account</h2>
    <p class="muted">
      Fill out the form below to create a new user.
    </p>

    <form id="createAccountForm" method="POST" action="/create-account">
      <div class="form-group">
        <label for="caFirstName">First name</label>
        <input type="text" id="caFirstName" name="firstname" required>
      </div>

      <div class="form-group">
        <label for="caLastName">Last name</label>
        <input type="text" id="caLastName" name="lastname" required>
      </div>

      <div class="form-group">
        <label for="caUsername">Username</label>
        <input type="text" id="caUsername" name="username" required>
      </div>

      <div class="form-group">
        <label for="caPassword">Password</label>
        <input type="password" id="caPassword" name="password" required>
      </div>

      <div class="form-group">
        <label for="caRole">Role</label>
        <select id="caRole" name="role" required>
          <option value="">-- Select role --</option>
          <option value="System Administrator">System Administrator</option>
          <option value="Inventory Clerk">Inventory Clerk</option>
          <option value="Warehouse Associate">Warehouse Associate</option>
        </select>
      </div>

      <div class="form-group">
        <label>Security question</label>
        <input type="text" value="What state were you born?" disabled>
      </div>

      <div class="form-group">
        <label for="caSecurityAnswer">Security answer</label>
        <input type="text" id="caSecurityAnswer" name="securityAnswer" required>
      </div>

      <div class="auth-modal__actions">
        <button type="submit" class="btn btn--small">
          Submit
        </button>
        <button type="button" class="btn btn--small btn--outline" id="cancelCreateAccountBtn">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

  {{!-- Temporary login area --}}
  <section class="login-temp">
    <h3>Please use this function to identify username and passwords.</h3>

    <div class="form-group">
      <label for="userSelect">Select a user</label>
      <select id="userSelect">
        <option value="">-- Choose a user --</option>
        {{#each users}}
          <option
            value="{{username}}"
            data-username="{{username}}"
            data-password="{{password}}"
            data-password-hash="{{passwordHash}}" 
            data-role="{{role}}"
          >
            {{firstname}} {{lastname}} ({{role}})
          </option>
        {{/each}}
      </select>
    </div>

    <div id="selectedUserInfo" class="selected-user-info">
      {{!-- Populated dynamically by login.js --}}
    </div>

    <button id="tempLoginBtn" class="btn" disabled>
      Log In as Selected User
    </button>
  </section>

</section>
