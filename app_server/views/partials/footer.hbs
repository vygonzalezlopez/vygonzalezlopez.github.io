    <a href="/placeholder">Instagram</a> <!-- Same placeholder route used for consistency -->
    <a href="/placeholder">LinkedIn</a> <!-- Placeholder for professional network link -->
  </div>

  <p class="footer__copy">
    © {{year}} CS-499 Computer Science Capstone <!-- Dynamic year + app attribution -->
  </p>
</footer>
